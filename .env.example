# Running port
PORT=5173

# Backend API base URL (optional: without it, blog/roadmap content is not loaded and editing is disabled)
BACKEND_URL=http://localhost:3000

# Keycloak OIDC settings, exposed to the frontend
KEYCLOAK_URL=https://your-keycloak.example.com
KEYCLOAK_REALM=your-realm
KEYCLOAK_CLIENT_ID=your-client-id

# Server only, never sent to the browser. When set, the Vite server (`npm run dev`
# or `npm start`) proxies the token exchange; otherwise the backend must (BACKEND_URL)
KEYCLOAK_CLIENT_SECRET=
